{
  "name": "web-dashboard-init",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run copy-standalone",
    "copy-standalone": "node -e \"const fs=require('fs');const p=require('path');const src=p.join('.next','static');const dst=p.join('.next','standalone','.next','static');fs.cpSync(src,dst,{recursive:true});console.log('Copied .next/static → standalone/.next/static');\"",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4"
  }
}
